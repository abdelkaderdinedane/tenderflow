# TenderFlow Phase 4 — Environment Variables
# Copy to .env and fill in values

# App
APP_NAME=TenderFlow MVP
APP_VERSION=4.0.0
DEBUG=false

# Database
DATABASE_URL=postgresql://tenderflow:tenderflow123@localhost:5432/tenderflow_db

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Agent
AGENT_TIMEOUT=300
AGENT_MAX_RETRIES=3
AGENT_RETRY_WAIT=5

# Security — CHANGE THIS IN PRODUCTION
API_KEY=tenderflow-phase4-secret-key

# CORS
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:3000"]

